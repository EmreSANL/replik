# ========================================================
# REPLIK - ÇEVRE DEĞİŞKENLERİ ŞABLONU (.env.example)
# Bu dosyayı .env.local olarak kopyalayıp kendi anahtarlarınızı girin.
# Gerçek anahtarları asla Git'e commit ETMEYİN!
# ========================================================

# Supabase Veritabanı ve Medya Deposu (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Ses ayırma: yalnızca sunucuda tutun, NEXT_PUBLIC_ öneki kullanmayın.
# Ücretsiz MVSEP hesabınızın API anahtarı varsa önce bu kullanılır.
# Anahtarı https://mvsep.com/en/full_api sayfasında giriş yaparak görebilirsiniz.
MVSEP_API_KEY=
# MVSEP yoksa AudioShake; o da yoksa kendi cinematic worker'ınız kullanılır.
AUDIOSHAKE_API_KEY=
CINEMATIC_API_URL=http://127.0.0.1:8011
CINEMATIC_API_KEY=replace-with-a-random-server-secret

# NVIDIA NIM AI API Key (İsteğe bağlı)
NVIDIA_API_KEY=your-nvidia-api-key-here
